---
// Recolours the line drawings from the COA decks (stick figure, star, arrow, silhouettes) via CSS mask.
import { doodleImg } from "../lib/assets";
interface Props { name: string; class?: string; color?: string; width?: number }
const { name, class: cls, color = "currentColor", width = 120 } = Astro.props;
const img = doodleImg[name];
const ratio = img.height / img.width;
---
<span
  class:list={["sketch", cls]}
  aria-hidden="true"
  style={`--m:url(${img.src});width:${width}px;aspect-ratio:${1 / ratio};background:${color}`}
></span>

<style>
  .sketch {
    display: block;
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
  }
</style>
