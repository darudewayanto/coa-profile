---
import { u } from "../lib/url";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, site } from "../data/site";

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length).replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class:list={["site-header", { overlay }]} data-header>
  <div class="bar wrap">
    <a href={u("/")} class="brand" aria-label="Center of Agility — beranda">
      <Logo size={46} />
      <span class="brand-text">Center of<br /><b>Agility</b></span>
    </a>

    <nav class="links" aria-label="Utama">
      {nav.map((n) => (
        <a href={u(n.href)} class:list={[{ active: isActive(n.href) }]} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>

    <a href={site.communityUrl} target="_blank" rel="noopener" class="btn btn-sun cta">Gabung</a>

    <button class="toggle" aria-expanded="false" aria-controls="mobile-nav" data-toggle>
      <span class="sr-only">Buka menu</span>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
  </div>

  <div class="mobile wrap" id="mobile-nav" data-mobile hidden>
    <nav aria-label="Mobile">
      {nav.map((n) => <a href={u(n.href)} class:list={[{ active: isActive(n.href) }]}>{n.label}</a>)}
    </nav>
    <a class="btn btn-sun" href={site.communityUrl} target="_blank" rel="noopener">Gabung Komunitas COA</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: #fff;
    background: var(--night);
    transition: background 0.35s, box-shadow 0.35s;
  }
  .site-header.overlay { position: fixed; inset: 0 0 auto 0; background: transparent; }
  .site-header.scrolled, .site-header.open {
    background: rgba(23, 10, 74, 0.86);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 76px; }
  .brand { flex: none; display: flex; align-items: center; gap: 0.65rem; }
  .brand-text { font-size: 0.78rem; line-height: 1.1; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .brand-text b { font-family: var(--serif); font-weight: 400; font-size: 1.35rem; letter-spacing: 0; text-transform: none; }

  .links { display: none; margin-inline: auto; gap: 0.15rem; }
  .links a {
    font-size: 0.86rem;
    font-weight: 600;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.82);
    transition: color 0.2s, background 0.2s;
  }
  .links a:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .links a.active { color: var(--sun); }
  .cta { display: none; padding: 0.6rem 1.15rem; font-size: 0.8rem; }

  .toggle {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--sun);
    color: var(--night);
    cursor: pointer;
  }
  .toggle :global(.i-close) { display: none; }
  .toggle[aria-expanded="true"] :global(.i-close) { display: block; }
  .toggle[aria-expanded="true"] :global(.i-open) { display: none; }

  .mobile { display: grid; gap: 1.25rem; padding-bottom: 1.5rem; }
  .mobile[hidden] { display: none; }
  .mobile nav { display: grid; }
  .mobile nav a { font-family: var(--serif); font-size: 1.7rem; padding: 0.45rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .mobile nav a.active { color: var(--sun); }

  @media (min-width: 1000px) {
    .links, .cta { display: flex; }
    .toggle, .mobile { display: none !important; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const toggle = header.querySelector<HTMLButtonElement>("[data-toggle]")!;
  const panel = header.querySelector<HTMLElement>("[data-mobile]")!;
  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel.hidden = open;
    header.classList.toggle("open", !open);
  });
  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 24);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
