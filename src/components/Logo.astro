---
// COA mark as it appears on Instagram: the white seal on the violet→magenta gradient disc.
import { Image } from "astro:assets";
import seal from "../assets/brand/coa-2.png";
interface Props { size?: number; class?: string }
const { size = 52, class: cls } = Astro.props;
---
<span class:list={["coa-logo", cls]} style={`--s:${size}px`}>
  <Image src={seal} alt="" width={Math.min(371, Math.round(size * 2))} loading="eager" />
</span>

<style>
  .coa-logo {
    display: grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, #7b3cff 0%, var(--violet) 45%, var(--magenta) 100%);
    box-shadow: 0 8px 22px -10px rgba(74, 31, 216, 0.8);
    flex: none;
  }
  .coa-logo :global(img) { width: 92%; height: 92%; object-fit: contain; }
</style>
