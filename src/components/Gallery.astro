---
import { Image } from "astro:assets";
import { eventImg } from "../lib/assets";
import { gallery } from "../data/site";
interface Props { limit?: number; title?: string }
const { limit = gallery.length, title = "COA <span class='brush pink'>di Kampus</span>" } = Astro.props;
const items = gallery.slice(0, limit);
---
<section class="gallery section bg-night on-dark">
  <div class="wrap">
    <div class="head" data-reveal>
      <span class="eyebrow">Galeri Kegiatan</span>
      <h2 class="h-lg" set:html={title} />
    </div>
    <ul class="masonry">
      {items.map((g, i) => (
        <li data-reveal class:list={[{ wide: i % 5 === 0 }]}>
          <figure>
            <Image src={eventImg[g.file]} alt={g.caption} widths={[600, 900, 1300, 1800]} sizes="(min-width: 980px) 33vw, (min-width: 640px) 50vw, 100vw" quality={88} />
            <figcaption>{g.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .masonry { display: grid; gap: 1rem; grid-template-columns: 1fr; grid-auto-flow: dense; }
  figure { margin: 0; position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 10; background: var(--night-2); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  figure:hover :global(img) { transform: scale(1.04); }
  figcaption {
    position: absolute; inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    font-size: 0.82rem; font-weight: 600; line-height: 1.35;
    background: linear-gradient(180deg, transparent, rgba(23, 10, 74, 0.9));
  }
  @media (min-width: 640px) {
    .masonry { grid-template-columns: repeat(2, 1fr); }
    .wide { grid-column: span 2; }
    .wide figure { aspect-ratio: 21 / 9; }
  }
  @media (min-width: 980px) {
    .masonry { grid-template-columns: repeat(3, 1fr); }
    .wide { grid-column: span 2; grid-row: span 2; }
    .wide figure { aspect-ratio: auto; height: 100%; }
  }
</style>
