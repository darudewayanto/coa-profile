---
import { Image } from "astro:assets";
import { partnerImg } from "../lib/assets";
import { universities } from "../data/site";
interface Props { title?: string; lead?: string }
const { title = "Sudah hadir di <span class='brush'>12 kampus</span>", lead = "Center of Agility on Campus tumbuh bersama perguruan tinggi negeri dan swasta di berbagai kota." } = Astro.props;
---
<section class="partners section bg-white">
  <div class="wrap">
    <div class="head" data-reveal>
      <span class="eyebrow">Kampus Partner</span>
      <h2 class="h-lg" set:html={title} />
      <p class="lead">{lead}</p>
    </div>
    <ul class="grid">
      {universities.map((p, i) => (
        <li data-reveal style={`transition-delay:${(i % 6) * 60}ms`}>
          <Image src={partnerImg[p.file]} alt={p.name} height={88} densities={[1, 2]} />
          <span>{p.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: grid; gap: 1rem; justify-items: center; text-align: center; margin-bottom: 3rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  li {
    display: grid; justify-items: center; align-content: center; gap: 0.8rem;
    padding: 1.5rem 1rem;
    border-radius: var(--radius);
    background: var(--paper);
    text-align: center;
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  li:hover { transform: translateY(-4px); box-shadow: 0 18px 36px -24px rgba(74, 31, 216, 0.6); }
  li :global(img) { height: 76px; width: auto; max-width: 100%; object-fit: contain; }
  li span { font-size: 0.78rem; font-weight: 600; color: var(--ink-soft); line-height: 1.3; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 980px) { .grid { grid-template-columns: repeat(6, 1fr); } }
</style>
