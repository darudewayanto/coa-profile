---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Doodle from "../components/Doodle.astro";
import Sketch from "../components/Sketch.astro";
import Icon from "../components/Icon.astro";
import { site, classSeries, wa } from "../data/site";

const shots = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: ImageMetadata }>("../assets/community/*.png", { eager: true })).map(([p, m]) => [p.split("/").pop()!.replace(".png", ""), m.default]),
);
const join = site.communityUrl;
const login = site.communityLoginUrl;

const why = [
  { icon: "layers", title: "Belajar nggak berhenti di workshop", text: "Lanjutkan materi COA kapan saja — dari HP, di sela kuliah, organisasi, atau magang." },
  { icon: "users", title: "Teman seperjuangan se-Indonesia", text: "Ketemu mahasiswa dari kampus partner COA lain, para Duta Agility, dan alumni micro-credential." },
  { icon: "coach", title: "Dekat dengan para coach", text: "Tanya langsung ke professional agile coach HADE dan dapat feedback untuk proyekmu." },
  { icon: "heart", title: "Jaga mental tetap fit", text: "Kelas mental fitness, anti-fragile, dan killing negative thoughts — gratis untuk anggota." },
  { icon: "certificate", title: "Sertifikat yang bisa dicek", text: "Selesaikan kelas, dapatkan sertifikat dengan link verifikasi online — modal CV dan LinkedIn." },
  { icon: "bolt", title: "Siap kerja & berwirausaha", text: "Bekal komunikasi, presentasi, sampai bikin pitch deck untuk startup pertamamu." },
];

const features = [
  { icon: "chat", title: "Komunitas", text: "Diskusi, polling, dan berbagi cerita dengan sesama anggota." },
  { icon: "layers", title: "Kelas", text: "Modul demi modul dengan progres belajar — banyak yang gratis." },
  { icon: "calendar", title: "Acara", text: "Webinar, sesi coaching, dan event kampus — RSVP sekali klik." },
  { icon: "users", title: "Anggota & Pesan", text: "Cari teman satu minat dan kirim pesan langsung." },
  { icon: "award", title: "Peringkat", text: "Kumpulkan poin dari kontribusimu, naik level, dan masuk leaderboard." },
  { icon: "certificate", title: "Sertifikat", text: "Bukti belajar yang bisa diverifikasi siapa saja." },
];

const steps = [
  { title: "Buka komunitas COA", text: "Klik Gabung, kamu akan diarahkan ke belajaragile.com/coa." },
  { title: "Daftar atau masuk", text: "Pakai email kampus/pribadi, atau lanjut dengan Google. Sudah punya akun? Langsung masuk." },
  { title: "Mulai dari WELCOME", text: "Tonton kelas WELCOME, lanjut Level 1 · Agile Mindset — keduanya gratis." },
];

---
<Base title="Belajar Agile" description="Join gratis komunitas belajar COA di belajaragile.com/coa: kelas Micro-Credential Level 1–5, Agility & Mental Fitness, komunikasi, dan entrepreneurship untuk mahasiswa & anak muda. Gratis untuk bergabung.">
  <!-- HERO -->
  <section class="c-hero bg-night on-dark">
    <Doodle kind="loop" class="hd1" color="var(--pink)" width={260} />
    <Doodle kind="star" class="hd2" color="var(--sun)" width={60} />
    <div class="wrap hero-grid">
      <div class="copy">
        <span class="eyebrow">COA Community Platform</span>
        <h1 class="h-xl">Belajar agile, <span class="brush">bareng</span> teman seperjuangan.</h1>
        <p class="lead">Ruang belajar online Center of Agility untuk mahasiswa dan anak muda: kelas micro-credential, mental fitness, komunikasi, sampai entrepreneurship — plus komunitas yang saling dukung.</p>
        <div class="btns">
          <a class="btn btn-sun btn-big pulse" href={join} target="_blank" rel="noopener">Join Gratis Sekarang <Icon name="arrow-up-right" size={20} /></a>
          <a class="btn btn-ghost" href={login} target="_blank" rel="noopener">Masuk</a>
        </div>
        <p class="hand note">100% gratis · daftar 1 menit · belajaragile.com/coa ✦</p>
      </div>
      <figure class="shot tilt">
        <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>belajaragile.com/coa</span></div>
        <Image src={shots["feed"]} alt="Feed komunitas Center of Agility: kategori diskusi, kohort MC Batch 1 – Level 1, dan peringkat 30 hari" widths={[600, 1000, 1400]} sizes="(min-width: 980px) 560px, 92vw" loading="eager" quality={90} />
        <figcaption>Feed komunitas · nama & pesan anggota diburamkan untuk privasi</figcaption>
      </figure>
    </div>
  </section>

  <!-- WHY -->
  <section class="section bg-cream">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="eyebrow">Kenapa gabung</span>
        <h2 class="h-lg">Tumbuh lebih cepat kalau <span class="brush pink">bareng-bareng</span>.</h2>
        <p class="lead">Workshop COA di kampus menyalakan apinya — komunitas yang menjaganya tetap menyala sampai kamu lulus dan masuk dunia kerja.</p>
      </div>
      <ul class="why">
        {why.map((w, i) => (
          <li data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
            <span class="ic"><Icon name={w.icon} size={26} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLASSES -->
  <section class="section bg-paper" id="kelas">
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="eyebrow">Kelas di platform</span>
        <h2 class="h-lg">Pilih <span class="brush">jalur belajarmu</span></h2>
        <p class="lead">Mulai dari kelas gratis — WELCOME, Level 1 Agile Mindset, Mental Fitness, dan Communications.</p>
      </div>

      {classSeries.map((s, i) => (
        <article class:list={["series", { flip: i % 2 }]}>
          <div class="s-body" data-reveal>
            <span class="tag">Seri {i + 1}</span>
            <h3 class="h-md">{s.name}</h3>
            <p class="s-text">{s.text}</p>
            <ul class="classes">
              {s.classes.map((c) => (
                <li><span class="ct">{c.title}</span>{c.tier === "Gratis" && <span class="tier free">Gratis</span>}</li>
              ))}
            </ul>
          </div>
          <figure class="shot" data-reveal>
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>belajaragile.com/coa · Kelas</span></div>
            <Image src={shots[s.shot]} alt={`Daftar kelas ${s.name} di komunitas COA`} widths={[738]} sizes="(min-width: 980px) 560px, 92vw" quality={95} />
          </figure>
        </article>
      ))}

      <div class="center" data-reveal>
        <a class="btn btn-sun btn-big" href={join} target="_blank" rel="noopener">Join Gratis Sekarang <Icon name="arrow-up-right" size={20} /></a>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section bg-violet on-dark feat-sec">
    <Sketch name="jumpers" class="jump" color="rgba(255,255,255,.18)" width={300} />
    <div class="wrap">
      <div class="head" data-reveal>
        <span class="eyebrow">Ada apa di dalamnya</span>
        <h2 class="h-lg">Satu tempat untuk belajar, ngobrol, dan naik level.</h2>
      </div>
      <ul class="feat">
        {features.map((f, i) => (
          <li data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
            <Icon name={f.icon} size={28} />
            <h3 class="h-sm">{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STEPS -->
  <section class="section bg-white">
    <div class="wrap">
      <div class="head center-head" data-reveal>
        <span class="eyebrow">Cara bergabung</span>
        <h2 class="h-lg">Tiga langkah, <span class="brush">langsung mulai</span>.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="num">{i + 1}</span>
            <h3 class="h-sm">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta section bg-grad on-dark">
    <Doodle kind="spark" class="cd1" color="var(--sun)" width={80} />
    <Doodle kind="squiggle" class="cd2" color="#fff" width={160} />
    <div class="wrap cta-inner" data-reveal>
      <p class="kick">Join gratis sekarang</p>
      <h2 class="h-lg">Siap jadi <span class="brush">Agile Young Leader</span>?</h2>
      <p class="lead">Daftar gratis, langsung mulai dari kelas WELCOME. Kampusmu belum punya COA? Ajak dosen atau BEM-mu ngobrol dengan kami.</p>
      <div class="btns">
        <a class="btn btn-sun btn-big pulse" href={join} target="_blank" rel="noopener">Join Gratis Sekarang <Icon name="arrow-up-right" size={20} /></a>
        <a class="btn btn-ghost" href={login} target="_blank" rel="noopener">Sudah punya akun? Masuk</a>
        <a class="btn btn-wa" href={wa("student")} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Tanya dulu</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bg-paper { background: var(--paper); }
  .btns { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .c-hero { position: relative; overflow: hidden; padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(4rem, 8vw, 7rem); }
  .c-hero :global(.hd1) { left: -60px; bottom: 30px; opacity: 0.7; }
  .c-hero :global(.hd2) { right: 6%; top: 2rem; }
  .hero-grid { display: grid; gap: 3rem; align-items: center; }
  .copy { display: grid; gap: 1.3rem; }
  .note { font-size: 1.4rem; color: var(--sun); }
  @media (min-width: 980px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  /* Browser-frame screenshots, shown at (not above) their native size so they stay crisp. */
  .shot { margin: 0; justify-self: center; width: 100%; max-width: 560px; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1); }
  .tilt { transform: rotate(1.5deg); }
  .bar { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; background: #eeeaf8; }
  .bar i { width: 10px; height: 10px; border-radius: 50%; background: #d4cce8; }
  .bar i:first-child { background: #ff6159; } .bar i:nth-child(2) { background: #ffbd2e; } .bar i:nth-child(3) { background: #28c941; }
  .bar span { margin-left: 0.6rem; font-size: 0.75rem; color: var(--ink-soft); background: #fff; border-radius: 6px; padding: 0.15rem 0.7rem; }
  .shot :global(img) { width: 100%; height: auto; }
  .shot figcaption { padding: 0.5rem 0.9rem; font-size: 0.75rem; color: var(--ink-soft); background: #f7f5fc; }
  .btn-big { padding: 1.1rem 1.9rem; font-size: 1rem; }
  .pulse { animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 210, 63, 0.55); } 60% { box-shadow: 0 0 0 16px rgba(255, 210, 63, 0); } }
  .kick { font-family: var(--hand); font-size: 1.8rem; color: var(--sun); transform: rotate(-2deg); }

  .head { display: grid; gap: 1rem; max-width: 780px; margin-bottom: 3rem; }
  .center-head { margin-inline: auto; text-align: center; justify-items: center; }

  .why { display: grid; gap: 1.1rem; }
  .why li { padding: 1.7rem 1.5rem; border-radius: 18px; background: #fff; display: grid; gap: 0.6rem; align-content: start; }
  .why h3 { font-size: 1.35rem; }
  .why p { color: var(--ink-soft); }
  .ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--grad); color: #fff; }
  @media (min-width: 720px) { .why { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .why { grid-template-columns: repeat(3, 1fr); } }

  .series { display: grid; gap: 2.5rem; align-items: center; padding: clamp(2rem, 4vw, 3.5rem) 0; border-top: 1px dashed var(--line); }
  .s-body { display: grid; gap: 1rem; }
  .s-body .tag { justify-self: start; }
  .s-text { color: var(--ink-soft); }
  .classes { display: grid; gap: 0.5rem; }
  .classes li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.75rem 1rem; border-radius: 12px; background: #fff; }
  .ct { font-weight: 600; font-size: 0.93rem; }
  .tier { flex: none; font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.6rem; border-radius: 999px; white-space: nowrap; }
  .tier.free { background: #dcf7e8; color: #127a43; }
  .tier.premium { background: #fff1c2; color: #8a5a00; }
  .tier.product { background: #efe4ff; color: var(--violet); }
  @media (min-width: 980px) {
    .series { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .flip .s-body { order: 2; }
  }
  .center { text-align: center; margin-top: 2.5rem; }

  .feat-sec { position: relative; overflow: hidden; }
  .feat-sec :global(.jump) { position: absolute; right: -30px; bottom: 20px; }
  .feat { display: grid; gap: 1rem; }
  .feat li { padding: 1.6rem 1.4rem; border-radius: 18px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); display: grid; gap: 0.6rem; align-content: start; }
  .feat :global(svg) { color: var(--sun); }
  .feat p { color: rgba(255, 255, 255, 0.82); }
  @media (min-width: 720px) { .feat { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .feat { grid-template-columns: repeat(3, 1fr); } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .steps li { padding: 1.8rem 1.5rem; border-radius: 18px; background: var(--paper); display: grid; gap: 0.6rem; align-content: start; }
  .num { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--sun); font-family: var(--serif); font-size: 1.7rem; color: var(--night); }
  .steps p { color: var(--ink-soft); }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, 1fr); } }

  .cta { position: relative; overflow: hidden; text-align: center; }
  .cta :global(.cd1) { left: 6%; top: 2.5rem; }
  .cta :global(.cd2) { right: 5%; bottom: 2.5rem; }
  .cta-inner { display: grid; gap: 1.2rem; justify-items: center; }
  .cta .btns { justify-content: center; }
</style>
