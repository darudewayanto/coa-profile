---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Doodle from "../components/Doodle.astro";
import Sketch from "../components/Sketch.astro";
import Icon from "../components/Icon.astro";
import Accreditation from "../components/Accreditation.astro";
import { doodleImg } from "../lib/assets";
import { levels, mcPillars, observation, wa } from "../data/site";
---
<Base title="Micro-Credential" description="COA Micro-Credential: lima level — Agile Mindset, Agility & Resilience, Agile Competency, Collaboration & Agile Team, Building Agile Culture. Terakreditasi internasional oleh ICF & MyBrain.">
  <PageHero
    eyebrow="COA Micro-Credential"
    title="Lima level. <span class='brush'>Satu</span> perjalanan."
    lead="Micro-credential berjenjang untuk mahasiswa — belajar, praktik lewat proyek, dan didampingi professional agile coach. Terakreditasi internasional oleh ICF & MyBrain."
    photo="dsc00982"
    alt="Mahasiswa mengikuti sesi Agile Mindset di auditorium"
    tone="pink"
  >
    <div class="hero-cta">
      <a class="btn btn-sun" href={wa("student")} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Daftar Batch Berikutnya</a>
      <a class="btn btn-ghost" href="#kurikulum">Lihat Kurikulum</a>
    </div>
  </PageHero>

  <!-- WHY: Being & Doing (Michael Sahota) -->
  <section class="why section bg-cream">
    <div class="wrap why-grid">
      <div data-reveal>
        <span class="eyebrow">Why this program</span>
        <h2 class="h-lg">Agile itu <span class="brush">being</span>, bukan sekadar doing.</h2>
        <p class="lead">Mengubah cara kerja tanpa mengubah cara berpikir hanya memberi manfaat kecil. Karena itu COA memulai dari mindset — lalu membangun praktik di atasnya. Tujuannya: generasi muda yang siap menjadi daya ungkit bonus demografi menuju Indonesia Emas.</p>
      </div>
      <div class="scale" data-reveal>
        <div class="side doing">
          <span class="lbl">Doing · Practice</span>
          <ul><li>Practical tools</li><li>Framework</li><li>Process & procedure</li><li>Productivity</li><li>Team model</li></ul>
          <strong>~20%</strong><small>benefit</small>
        </div>
        <div class="side being">
          <span class="lbl">Being · Mindset</span>
          <ul><li>Engagement</li><li>Positivity</li><li>Mental fitness</li><li>Innovation & creativity</li><li>Continuous learning</li></ul>
          <strong>~3×</strong><small>benefit</small>
        </div>
        <p class="hand credit">— Michael Sahota, “Being & Mindset of Agile”</p>
        <Sketch name="stickman" class="stick" color="var(--violet)" width={110} />
        <Sketch name="star" class="star" color="var(--sun-2)" width={80} />
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="mp section bg-violet on-dark">
    <div class="wrap">
      <div class="mp-head" data-reveal>
        <span class="eyebrow">Program Pillar</span>
        <h2 class="h-md">Setiap level dijalani lewat tiga jalur.</h2>
      </div>
      <div class="mp-grid">
        {mcPillars.map((p, i) => (
          <article data-reveal style={`transition-delay:${i * 80}ms`}>
            <Image src={doodleImg[p.icon]} alt="" width={60} densities={[1, 2]} />
            <h3 class="h-sm">{p.name}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CURRICULUM: interactive level tabs -->
  <section class="curr section bg-paper" id="kurikulum">
    <div class="wrap">
      <div class="c-head" data-reveal>
        <span class="eyebrow">Program Journey</span>
        <h2 class="h-lg">Kurikulum <span class="brush">Level 1–5</span></h2>
        <p class="lead">Lima chapter per level. Klik setiap level untuk melihat topiknya.</p>
      </div>

      <div class="tabs" role="tablist" aria-label="Level micro-credential" data-tabs>
        {levels.map((l, i) => (
          <button role="tab" id={`tab-${l.level}`} aria-controls={`level-${l.level}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} style={`--i:${i}`}>
            <span>Level {l.level}</span>
            <b>{l.name}</b>
          </button>
        ))}
      </div>

      {levels.map((l, i) => (
        <article class="panel" role="tabpanel" id={`level-${l.level}`} aria-labelledby={`tab-${l.level}`} hidden={i !== 0}>
          <header>
            <span class="lv-num">{l.level}</span>
            <div>
              <h3 class="h-md">{l.name}</h3>
              <p class="hand tagline">{l.tagline}</p>
            </div>
          </header>
          <ol class="chapters">
            {l.chapters.map((c, ci) => (
              <li>
                <span class="ch">Chapter {ci + 1}</span>
                <h4>{c.title}</h4>
                <ul>{c.topics.map((t, ti) => <li><span>{ci + 1}.{ti + 1}</span> {t}</li>)}</ul>
              </li>
            ))}
          </ol>
          <div class="tracks">
            <div><span class="tag">Project & Simulation</span><p>{l.project}</p></div>
            <div><span class="tag">Agile Coaching</span><p>{l.coaching}</p></div>
          </div>
        </article>
      ))}

      <div class="winner" data-reveal>
        <Icon name="award" size={34} />
        <p><b>Puncak perjalanan:</b> Winner of Duta Agility — tingkat kampus, regional, dan nasional.</p>
      </div>
    </div>
  </section>

  <!-- ASSESSMENT -->
  <section class="obs section bg-night on-dark">
    <Doodle kind="loop" class="od" color="var(--pink)" width={240} />
    <div class="wrap">
      <div class="o-head" data-reveal>
        <span class="eyebrow">Observation Guideline</span>
        <h2 class="h-lg">Kami tidak hanya menilai nilai ujian.</h2>
        <p class="lead">Fasilitator mengamati perilaku setiap peserta di setiap sesi — kontribusi, pengaruh, dan pergeseran zona sikap dari awal hingga akhir sesi.</p>
      </div>
      <div class="o-grid">
        {observation.map((o) => (
          <article data-reveal>
            <h3 class="h-sm">{o.category}</h3>
            <ul>
              {o.items.map((it) => (
                <li class:list={[`z-${it.name.split(" ")[0].toLowerCase()}`]}><b>{it.name}</b><span>{it.text}</span></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ACCREDITATION + CTA -->
  <section class="acc section bg-white">
    <div class="wrap acc-inner" data-reveal>
      <span class="eyebrow">Program Accreditation</span>
      <h2 class="h-lg">Diakui <span class="brush">internasional</span></h2>
      <p class="lead">Micro-Credential COA terakreditasi internasional oleh ICF (International Coaching Federation) melalui CCE, dan oleh MyBrain melalui MiND — dalam ekosistem akreditasi HADE bersama IC-Agile.</p>
      <Accreditation />
      <div class="cta-row">
        <a class="btn btn-wa" href={wa("student")} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Daftar via WhatsApp</a>
        <a class="btn btn-violet" href={wa("campus")} target="_blank" rel="noopener">Bawa ke Kampus Saya</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bg-paper { background: var(--paper); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }

  .why-grid { display: grid; gap: 3rem; align-items: center; }
  .why-grid > div:first-child { display: grid; gap: 1.2rem; }
  .scale { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-bottom: 2.5rem; }
  .side { padding: 1.6rem 1.3rem; border-radius: 18px; display: grid; gap: 0.6rem; align-content: start; }
  .doing { background: #fff; border: 2px dashed var(--line); }
  .being { background: var(--grad); color: #fff; transform: translateY(-1.2rem); box-shadow: 0 30px 60px -30px rgba(74, 31, 216, 0.8); }
  .lbl { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
  .side ul { display: grid; gap: 0.3rem; font-size: 0.92rem; }
  .side li::before { content: "– "; opacity: 0.6; }
  .side strong { font-family: var(--serif); font-weight: 400; font-size: 3.2rem; line-height: 1; margin-top: 0.6rem; }
  .doing strong { color: var(--ink-soft); }
  .side small { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.14em; opacity: 0.8; }
  .credit { grid-column: 1 / -1; font-size: 1.25rem; color: var(--ink-soft); }
  .scale :global(.stick) { position: absolute; right: -10px; bottom: -30px; }
  .scale :global(.star) { position: absolute; left: -26px; top: -40px; }
  @media (min-width: 960px) { .why-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } }

  .mp-head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .mp-grid { display: grid; gap: 1.2rem; }
  .mp-grid article { padding: 2rem 1.6rem; border-radius: 18px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.18); display: grid; gap: 0.8rem; align-content: start; }
  .mp-grid :global(img) { width: 56px; height: 56px; object-fit: contain; }
  .mp-grid p { color: rgba(255, 255, 255, 0.82); }
  @media (min-width: 860px) { .mp-grid { grid-template-columns: repeat(3, 1fr); } }

  .c-head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .tabs { display: grid; grid-template-columns: repeat(5, minmax(150px, 1fr)); gap: 0.6rem; overflow-x: auto; padding-bottom: 0.6rem; scroll-snap-type: x mandatory; }
  .tabs button {
    scroll-snap-align: start;
    text-align: left; display: grid; gap: 0.2rem;
    padding: 1rem 1.1rem; border-radius: 14px; border: 2px solid var(--line);
    background: #fff; color: var(--ink); cursor: pointer; font: inherit;
    transition: background 0.25s, color 0.25s, border-color 0.25s, transform 0.25s var(--ease);
  }
  .tabs button span { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--magenta); }
  .tabs button b { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; line-height: 1.15; }
  .tabs button:hover { transform: translateY(-2px); border-color: var(--violet); }
  .tabs button[aria-selected="true"] { background: var(--grad); color: #fff; border-color: transparent; }
  .tabs button[aria-selected="true"] span { color: var(--sun); }

  .panel { margin-top: 1.4rem; padding: clamp(1.4rem, 4vw, 2.8rem); border-radius: 22px; background: #fff; box-shadow: 0 30px 70px -50px rgba(74, 31, 216, 0.7); animation: rise 0.5s var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  .panel header { display: flex; gap: 1.2rem; align-items: center; margin-bottom: 2rem; }
  .lv-num { flex: none; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: var(--sun); font-family: var(--serif); font-size: 3rem; color: var(--night); }
  .tagline { font-size: 1.5rem; color: var(--magenta); line-height: 1.2; margin-top: 0.2rem; }
  .chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .chapters > li { padding: 1.2rem; border-radius: 14px; background: var(--paper); border-top: 4px solid var(--violet); }
  .chapters > li:nth-child(even) { border-color: var(--magenta); }
  .ch { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .chapters h4 { font-family: var(--serif); font-weight: 400; font-size: 1.2rem; line-height: 1.15; margin: 0.3rem 0 0.7rem; }
  .chapters ul { display: grid; gap: 0.3rem; font-size: 0.86rem; color: var(--ink-soft); }
  .chapters ul span { font-weight: 700; color: var(--violet); margin-right: 0.2rem; }
  .tracks { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .tracks > div { display: grid; gap: 0.5rem; padding: 1.1rem 1.2rem; border-radius: 14px; border: 2px dashed var(--line); }
  .tracks .tag { justify-self: start; }
  .tracks p { font-weight: 600; }
  @media (min-width: 720px) { .chapters { grid-template-columns: repeat(2, 1fr); } .tracks { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .chapters { grid-template-columns: repeat(5, 1fr); } }

  .winner { margin-top: 2rem; display: flex; gap: 1rem; align-items: center; padding: 1.2rem 1.5rem; border-radius: 16px; background: var(--sun); color: var(--night); }

  .obs { overflow: hidden; }
  .obs :global(.od) { right: -40px; top: 40px; opacity: 0.8; }
  .o-head { display: grid; gap: 1rem; max-width: 760px; margin-bottom: 2.5rem; }
  .o-grid { display: grid; gap: 1.2rem; }
  .o-grid article { padding: 1.8rem 1.5rem; border-radius: 18px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); }
  .o-grid h3 { color: var(--sun); margin-bottom: 1rem; }
  .o-grid ul { display: grid; gap: 0.9rem; }
  .o-grid li { display: grid; gap: 0.15rem; padding-left: 0.9rem; border-left: 3px solid rgba(255, 255, 255, 0.3); }
  .o-grid li span { font-size: 0.9rem; color: rgba(255, 255, 255, 0.78); }
  .o-grid li.z-red { border-color: #ff5a6e; }
  .o-grid li.z-yellow { border-color: var(--sun); }
  .o-grid li.z-green { border-color: #3ddc97; }
  @media (min-width: 900px) { .o-grid { grid-template-columns: repeat(3, 1fr); } }

  .acc-inner { display: grid; gap: 1.3rem; justify-items: center; text-align: center; }
  .acc-inner .lead { margin-bottom: 1.2rem; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 1.5rem; }
</style>

<script>
  // Accessible tabs: click or arrow keys switch level; URL hash (#level-3) opens that level.
  const list = document.querySelector<HTMLElement>("[data-tabs]")!;
  const tabs = [...list.querySelectorAll<HTMLButtonElement>("[role=tab]")];
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => select(t));
    t.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length], true); }
    });
  });
  const fromHash = tabs.find((t) => `#${t.getAttribute("aria-controls")}` === location.hash);
  if (fromHash) { select(fromHash); document.getElementById("kurikulum")?.scrollIntoView(); }
</script>
