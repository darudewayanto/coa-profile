---
import Base from "../layouts/Base.astro";
import Doodle from "../components/Doodle.astro";
import { u } from "../lib/url";
---
<Base title="Halaman tidak ditemukan">
  <section class="nf section bg-grad on-dark">
    <Doodle kind="loop" class="d" color="var(--sun)" width={320} />
    <div class="wrap inner">
      <p class="hand">oops, mistake quota terpakai 1 ✦</p>
      <h1 class="h-xl">4<span class="brush">0</span>4</h1>
      <p class="lead">Halaman yang Anda cari tidak ada. Gagal itu bagian dari belajar. Mari kembali.</p>
      <a class="btn btn-sun" href={u("/")}>Kembali ke Beranda</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 70vh; display: grid; place-items: center; text-align: center; overflow: hidden; }
  .inner { display: grid; gap: 1.2rem; justify-items: center; position: relative; }
  .hand { font-size: 1.6rem; color: var(--sun); }
  .nf :global(.d) { left: 50%; top: 50%; transform: translate(-50%, -60%); }
</style>
